  "cd_source": {
    "commit": "cbf607561e3f90630ce7a57fe9a85f5bc0dfdd3c",
    "raw": "https://raw.githubusercontent.com/OpenMath/CDs/{commit}/{path}",
    "repository": "https://github.com/OpenMath/CDs"
  },
  "envelope": {
    "call": "scscp1.procedure_call",
    "completed": "scscp1.procedure_completed",
    "error": "scscp1.error_system_specific",
    "message": "scscp1.info_message",
    "procedure_cds": ["giac_procedures1", "prog1"],
    "terminated": "scscp1.procedure_terminated"
  },
  "format": 2,
  "giac_version": "2.0.0",
  "leaf": [
    {
      "giac": "pi",
      "om": "nums1.pi"
    },
    {
      "giac": "i",
      "note": "GIAC's i is the complex number 0+1*i (a CPLX value); any other complex value is complex1.complex_cartesian(re, im).",
      "om": "nums1.i"
    },
    {
      "giac": "euler_gamma",
      "om": "nums1.gamma"
    },
    {
      "direction": "from_openmath",
      "giac": "e",
      "note": "GIAC reads e as exp(1), which goes to OpenMath as transc1.exp(1).",
      "om": "nums1.e"
    },
    {
      "direction": "from_openmath",
      "giac": "+infinity",
      "note": "GIAC's own tree is +(infinity): see the map for it. Bare `infinity` in GIAC is unsigned, and refused.",
      "om": "nums1.infinity"
    },
    {
      "giac": "true",
      "om": "logic1.true"
    },
    {
      "giac": "false",
      "om": "logic1.false"
    }
  ],
  "map": [
    {
      "giac": ["+", "#*"],
      "input": "infix",
      "note": "GIAC writes x-y as +(x, -(y)).",
      "om": ["arith1.plus", "#*"]
    },
    {
      "giac": ["*", "#*"],
      "input": "infix",
      "om": ["arith1.times", "#*"]
    },
    {
      "giac": ["-", "#1"],
      "input": "prefix",
      "om": ["arith1.unary_minus", "#1"]
    },
    {
      "direction": "from_openmath",
      "giac": ["-", "#1", "#2"],
      "input": "infix",
      "note": "Written a - b; GIAC reads it as +(a, -(b)).",
      "om": ["arith1.minus", "#1", "#2"]
    },
    {
      "direction": "to_openmath",
      "giac": ["+", "infinity"],
      "note": "GIAC's +infinity. A pattern with a name in it is tried before the general one.",
      "om": "nums1.infinity"
    },
    {
      "direction": "to_openmath",
      "giac": ["-", "infinity"],
      "note": "GIAC's -infinity.",
      "om": ["arith1.unary_minus", "nums1.infinity"]
    },
    {
      "giac": ["/", "#1", "#2"],
      "input": "infix",
      "note": "An unevaluated quotient. Evaluated, GIAC writes x/y as *(x, inv(y)).",
      "om": ["arith1.divide", "#1", "#2"]
    },
    {
      "direction": "to_openmath",
      "giac": ["inv", "#1"],
      "om": ["arith1.divide", 1, "#1"]
    },
    {
      "giac": ["^", "#1", "#2"],
      "input": "infix",
      "note": "GIAC evaluates sqrt(x) to x^(1/2), with the FRAC 1/2.",
      "om": ["arith1.power", "#1", "#2"]
    },
    {
      "giac": ["sqrt", "#1"],
      "note": "Unevaluated sqrt only. arith1.root leaves which root it is open; GIAC's sqrt is the principal square root.",
      "om": ["arith1.root", "#1", 2]
    },
    {
      "giac": ["abs", "#1"],
      "om": ["arith1.abs", "#1"]
    },
    {
      "giac": ["gcd", "#*"],
      "note": "GIAC's gcd is also the gcd of polynomials; the Content Dictionary speaks of its arguments without a domain.",
      "om": ["arith1.gcd", "#*"]
    },
    {
      "giac": ["lcm", "#*"],
      "note": "As for gcd: GIAC's lcm also takes polynomials.",
      "om": ["arith1.lcm", "#*"]
    },
    {
      "giac": ["sum", "#1", "#2", "#3", "#4"],
      "note": "sum(f, k, a, b): the sum of f over the integers k from a to b.",
      "om": ["arith1.sum", ["interval1.integer_interval", "#3", "#4"], ["bind", "fns1.lambda", ["#2"], "#1"]]
    },
    {
      "giac": ["product", "#1", "#2", "#3", "#4"],
      "om": ["arith1.product", ["interval1.integer_interval", "#3", "#4"], ["bind", "fns1.lambda", ["#2"], "#1"]]
    },
    {
      "aliases": ["log"],
      "giac": ["ln", "#1"],
      "note": "GIAC's log is the natural logarithm (a node ln), as is Julia's log; transc1.log is the logarithm to a base.",
      "om": ["transc1.ln", "#1"]
    },
    {
      "giac": ["logb", "#1", "#2"],
      "note": "logb(x, b) is log to the base b of x; transc1.log takes the base first. GIAC evaluates logb to ln(x)/ln(b).",
      "om": ["transc1.log", "#2", "#1"]
    },
    {
      "direction": "to_openmath",
      "giac": ["log10", "#1"],
      "note": "From OpenMath, transc1.log(10, x) is logb(x, 10).",
      "om": ["transc1.log", 10, "#1"]
    },
    {
      "giac": ["exp", "#1"],
      "om": ["transc1.exp", "#1"]
    },
    {
      "giac": ["sin", "#1"],
      "om": ["transc1.sin", "#1"]
    },
    {
      "giac": ["cos", "#1"],
      "om": ["transc1.cos", "#1"]
    },
    {
      "giac": ["tan", "#1"],
      "om": ["transc1.tan", "#1"]
    },
    {
      "giac": ["sec", "#1"],
      "note": "GIAC evaluates sec(x) to 1/cos(x).",
      "om": ["transc1.sec", "#1"]
    },
    {
      "giac": ["csc", "#1"],
      "note": "GIAC evaluates csc(x) to 1/sin(x).",
      "om": ["transc1.csc", "#1"]
    },
    {
      "giac": ["cot", "#1"],
      "note": "GIAC evaluates cot(x) to cos(x)/sin(x).",
      "om": ["transc1.cot", "#1"]
    },
    {
      "aliases": ["arcsin"],
      "giac": ["asin", "#1"],
      "om": ["transc1.arcsin", "#1"]
    },
    {
      "aliases": ["arccos"],
      "giac": ["acos", "#1"],
      "om": ["transc1.arccos", "#1"]
    },
    {
      "aliases": ["arctan"],
      "giac": ["atan", "#1"],
      "om": ["transc1.arctan", "#1"]
    },
    {
      "giac": ["asec", "#1"],
      "note": "GIAC evaluates asec(x) to acos(1/x).",
      "om": ["transc1.arcsec", "#1"]
    },
    {
      "giac": ["acsc", "#1"],
      "note": "GIAC evaluates acsc(x) to asin(1/x).",
      "om": ["transc1.arccsc", "#1"]
    },
    {
      "giac": ["acot", "#1"],
      "note": "GIAC evaluates acot(x) to atan(1/x), which differs from the usual arccot for x < 0.",
      "om": ["transc1.arccot", "#1"]
    },
    {
      "giac": ["sinh", "#1"],
      "om": ["transc1.sinh", "#1"]
    },
    {
      "giac": ["cosh", "#1"],
      "om": ["transc1.cosh", "#1"]
    },
    {
      "giac": ["tanh", "#1"],
      "om": ["transc1.tanh", "#1"]
    },
    {
      "aliases": ["arcsinh"],
      "giac": ["asinh", "#1"],
      "note": "GIAC evaluates asinh(x) to ln(x + sqrt(x^2 + 1)).",
      "om": ["transc1.arcsinh", "#1"]
    },
    {
      "aliases": ["arccosh"],
      "giac": ["acosh", "#1"],
      "note": "GIAC evaluates acosh(x) to ln(x + sqrt(x^2 - 1)).",
      "om": ["transc1.arccosh", "#1"]
    },
    {
      "aliases": ["arctanh"],
      "giac": ["atanh", "#1"],
      "note": "GIAC evaluates atanh(x) to ln((1 + x)/(1 - x))/2.",
      "om": ["transc1.arctanh", "#1"]
    },
    {
      "giac": ["=", "#1", "#2"],
      "input": "infix",
      "note": "GIAC's = builds an equation, kept as such.",
      "om": ["relation1.eq", "#1", "#2"]
    },
    {
      "direction": "to_openmath",
      "giac": ["==", "#1", "#2"],
      "input": "infix",
      "note": "GIAC's == is a test, evaluated at once: x == y is false for two distinct names.",
      "om": ["relation1.eq", "#1", "#2"]
    },
    {
      "giac": ["<", "#1", "#2"],
      "input": "infix",
      "note": "GIAC evaluates x < y to y > x.",
      "om": ["relation1.lt", "#1", "#2"]
    },
    {
      "giac": [">", "#1", "#2"],
      "input": "infix",
      "om": ["relation1.gt", "#1", "#2"]
    },
    {
      "giac": ["<=", "#1", "#2"],
      "input": "infix",
      "note": "GIAC evaluates x <= y to y >= x.",
      "om": ["relation1.leq", "#1", "#2"]
    },
    {
      "giac": [">=", "#1", "#2"],
      "input": "infix",
      "om": ["relation1.geq", "#1", "#2"]
    },
    {
      "giac": ["!=", "#1", "#2"],
      "input": "infix",
      "note": "A test, evaluated at once: x != y is true for two distinct names. GIAC prints it <>.",
      "om": ["relation1.neq", "#1", "#2"]
    },
    {
      "giac": ["and", "#*"],
      "input": "infix",
      "om": ["logic1.and", "#*"]
    },
    {
      "giac": ["or", "#*"],
      "input": "infix",
      "om": ["logic1.or", "#*"]
    },
    {
      "giac": ["not", "#1"],
      "note": "Write not(a): GIAC reads `not a` without parentheses as undef.",
      "om": ["logic1.not", "#1"]
    },
    {
      "giac": [" xor ", "#1", "#2"],
      "input": "infix",
      "note": "The node's name has spaces around xor. GIAC evaluates a xor b on two names to 0.",
      "om": ["logic1.xor", "#1", "#2"]
    },
    {
      "giac": ["floor", "#1"],
      "om": ["rounding1.floor", "#1"]
    },
    {
      "giac": ["ceil", "#1"],
      "note": "GIAC evaluates ceil(x) to -floor(-x).",
      "om": ["rounding1.ceiling", "#1"]
    },
    {
      "giac": ["round", "#1"],
      "note": "GIAC evaluates round(x) to floor(x + 1/2): halves go up, which the Content Dictionary does not fix.",
      "om": ["rounding1.round", "#1"]
    },
    {
      "giac": ["trunc", "#1"],
      "note": "GIAC 2.1.0 evaluates trunc(x) on a name to floor(x), wrong for x < 0; on numbers it rounds toward zero.",
      "om": ["rounding1.trunc", "#1"]
    },
    {
      "giac": ["max", "#*"],
      "note": "minmax1.max takes one argument, a set.",
      "om": ["minmax1.max", ["set1.set", "#*"]]
    },
    {
      "giac": ["min", "#*"],
      "om": ["minmax1.min", ["set1.set", "#*"]]
    },
    {
      "giac": ["re", "#1"],
      "note": "GIAC takes names as real unless declared complex: re(x) evaluates to x.",
      "om": ["complex1.real", "#1"]
    },
    {
      "giac": ["im", "#1"],
      "note": "As for re: im(x) evaluates to 0 for a name.",
      "om": ["complex1.imaginary", "#1"]
    },
    {
      "giac": ["conj", "#1"],
      "om": ["complex1.conjugate", "#1"]
    },
    {
      "giac": ["arg", "#1"],
      "om": ["complex1.argument", "#1"]
    },
    {
      "giac": ["factorial", "#1"],
      "note": "GIAC prints factorial(n) as n!.",
      "om": ["integer1.factorial", "#1"]
    },
    {
      "giac": ["diff", "#1", "#2"],
      "note": "diff(f, x): the derivative of x -> f, at x.",
      "om": ["apply", ["calculus1.diff", ["bind", "fns1.lambda", ["#2"], "#1"]], "#2"]
    },
    {
      "giac": ["integrate", "#1", "#2"],
      "note": "integrate(f, x): an antiderivative of x -> f, at x. GIAC's int(f, x) is a node int until evaluated, then integrate.",
      "om": ["apply", ["calculus1.int", ["bind", "fns1.lambda", ["#2"], "#1"]], "#2"]
    },
    {
      "giac": ["integrate", "#1", "#2", "#3", "#4"],
      "om": ["calculus1.defint", ["interval1.interval", "#3", "#4"], ["bind", "fns1.lambda", ["#2"], "#1"]]
    },
    {
      "giac": ["limit", "#1", "#2", "#3"],
      "om": ["limit1.limit", "#3", "limit1.both_sides", ["bind", "fns1.lambda", ["#2"], "#1"]]
    },
    {
      "giac": ["limit", "#1", "#2", "#3", 1],
      "om": ["limit1.limit", "#3", "limit1.above", ["bind", "fns1.lambda", ["#2"], "#1"]]
    },
    {
      "giac": ["limit", "#1", "#2", "#3", -1],
      "om": ["limit1.limit", "#3", "limit1.below", ["bind", "fns1.lambda", ["#2"], "#1"]]
    },
    {
      "giac": ["sign", "#1"],
      "note": "A private CD: readers use it only when their caller enables private CDs. GIAC's sign: 0 at 0, z/|z| otherwise (complex numbers included).",
      "om": ["giac_math1.sign", "#1"]
    }
  ],
  "procedure": [
    {
      "giac": ["simplify", "#1"],
      "om": ["giac_procedures1.simplify", "#1"]
    },
    {
      "giac": ["expand", "#1"],
      "om": ["giac_procedures1.expand", "#1"]
    },
    {
      "giac": ["factor", "#1"],
      "om": ["giac_procedures1.factor", "#1"]
    },
    {
      "giac": ["solve", "#1", "#2"],
      "note": "solve(r, v): the solutions of r (a relation, or a list of them) in v.",
      "om": ["giac_procedures1.solve", "#1", "#2"]
    },
    {
      "giac": ["evalf", "#1"],
      "note": "An approximation, never an equality: its result is reported as such.",
      "om": ["giac_procedures1.evalf", "#1"]
    },
    {
      "giac": ["evalf", "#1", "#2"],
      "note": "evalf(e, d): d significant digits.",
      "om": ["giac_procedures1.evalf", "#1", "#2"]
    },
    {
      "giac": ["series", "#1", "#2", "#3", "#4"],
      "note": "series(e, v, a, n): the part of the expansion of e in v at a before GIAC's order term (negative or fractional powers possible; no order term when exact).",
      "om": ["giac_procedures1.series", "#1", "#2", "#3", "#4"]
    },
    {
      "giac": ["desolve", "#1", "#2"],
      "note": "The answer's constants (GIAC's c_0, c_1, ...) are new names, bound by the result.",
      "om": ["giac_procedures1.desolve", "#1", "#2"]
    },
    {
      "giac": ["sto", "#2", "#1"],
      "note": "a := value: sets a session's variable. prog1 is experimental: only when enabled. A definition f(x) := body needs a lambda as value, which the table does not map yet.",
      "om": ["prog1.assignment", "#1", "#2"]
    }
  ],
  "procedure_option": [
    {
      "giac": "assume",
      "note": "A semantic attribution on the call's argument: GIAC's assume for the call only (as Giac.jl's assuming). Relations, logic1.and, logic1.or, and set1.in(x, setname1.R) to declare x real.",
      "om": "giac_procedures1.premises"
    },
    {
      "giac": "complex_mode",
      "note": "A semantic attribution on the call's argument: logic1.true or logic1.false, GIAC's complex_mode for the call (it changes which factors factor finds; it does not declare variables real).",
      "om": "giac_procedures1.complex_mode"
    },
    {
      "giac": "timeout",
      "note": "On the procedure_call application itself, where scscp1 places its options. Milliseconds in scscp1; GIAC's time limit is in seconds.",
      "om": "scscp1.option_runtime"
    }
  ],
  "refused": [
    {
      "example": "x mod 3",
      "giac": "%",
      "om": "integer1.remainder",
      "reason": "GIAC's % (and x mod n) is a residue class modulo n, not a remainder: x mod 3 evaluates to (1 % 3)*x."
    },
    {
      "example": "irem(a, b)",
      "giac": "irem",
      "reason": "irem(-7, 3) is 2 in GIAC; integer1.remainder gives the remainder the sign of the dividend, -1. They agree for a >= 0 and b > 0 only."
    },
    {
      "example": "iquo(a, b)",
      "giac": "iquo",
      "om": "integer1.quotient",
      "reason": "iquo(-7, 3) is -3 in GIAC (rounding down); integer1.quotient goes with a remainder of the dividend's sign, so -2."
    },
    {
      "example": "a => b",
      "giac": "sto",
      "om": "logic1.implies",
      "reason": "GIAC's => is an assignment (a node sto), not an implication; GIAC has no implication operator."
    },
    {
      "giac": "infinity",
      "reason": "GIAC's bare infinity is unsigned; nums1.infinity is read as +infinity."
    },
    {
      "giac": "undef",
      "om": "nums1.NaN",
      "reason": "GIAC's undef is an undefined result of any computation, not a floating-point NaN."
    },
    {
      "example": "x -> x^2",
      "giac": "program",
      "reason": "GIAC's functions (x -> f) also carry local variables and statements; not mapped yet to fns1.lambda."
    }
  ]
}
